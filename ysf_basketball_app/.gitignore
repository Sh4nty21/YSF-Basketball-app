# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
# Exception: the compiled web build IS committed and deployed — Render's
# native-Python build step has no Flutter SDK to build this itself, so the
# production admin app at /admin is served from this checked-in output.
# Regenerate with `flutter build web --base-href /admin/` after any change
# and re-commit; nothing rebuilds it automatically.
!/build/web/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
