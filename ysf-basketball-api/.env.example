# ═══════════════════════════════════════════════════════════════════════════
#  YSF Basketball API — environment template
#  Copy this file to ".env" and fill in your real values.
#  NEVER commit the real ".env" (it is git-ignored).
# ═══════════════════════════════════════════════════════════════════════════

# ── DATABASE ───────────────────────────────────────────────────────────────
# Supabase "Connection pooling" URI (Project Settings -> Database -> Connection
# pooling). Port 6543. Replace [YOUR-PASSWORD] with your DB password.
# Because it is hosted, this works from anywhere — your laptop does NOT need
# to be on for the database to be reachable.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Alembic migrations need the DIRECT connection (port 5432), because the
# transaction pooler does not support the DDL/prepared-statement patterns
# migrations use. Same password, different host/port.
# Leave blank to just reuse DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── APP ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins for the check-in form.
# "*" is fine for local development.
CORS_ORIGINS=*

# Youth-fellowship age bounds, enforced server-side.
MIN_AGE=13
MAX_AGE=22

# ── ADMIN ACCOUNTS ─────────────────────────────────────────────────────────
# Every organizer endpoint now requires a logged-in admin account (see
# NEW_PROJECT_PLAN.md) — there is no "leave empty to stay open" mode anymore,
# and no public registration route. BOOTSTRAP_ADMIN_USERNAME/PASSWORD is the
# ONLY way the very first super-admin account gets created: on startup, if
# the admins table is still empty, one super-admin is created from these two
# values. Set them once, deploy, log in, change the password immediately
# (forced), then appoint every other admin from inside the app itself — no
# need to ever touch these two variables again (safe to leave set).
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# ── CHECK-IN FORM URL (used to build QR codes) ─────────────────────────────
# Where the public web check-in form is reachable. The API returns
# "<this>?session=<id>" as the QR payload for each session.
CHECKIN_BASE_URL=http://localhost:5500

# ── CHECK-IN ANTI-FLOODING ─────────────────────────────────────────────────
# Max self-check-ins the same browser/device may submit for one session.
# Leave unset for the default of 5.
CHECKIN_DEVICE_LIMIT=5
